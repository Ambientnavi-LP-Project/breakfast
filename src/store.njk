---
pagination:
  data: stores.stores
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/index.html"
eleventyComputed:
  title: "{{ store.name_full_en }}"
---
<!DOCTYPE html>
<html lang="en">
<head>
<!-- Google Tag Manager -->
