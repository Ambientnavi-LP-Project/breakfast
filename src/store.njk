{# === 店名を1本に統合 === #}
{% set shopName = store.name_full_en %}
{# === 内観写真の有無で、ヒーロー背景の出し分け（京都駅など未撮影店舗はフォールバック画像） === #}
{% set heroFallback = "/assets/family02.jpg" %}

  <div class="halal-sticky">
    <span class="halal-dot"></span>
    <span>MUSLIM-FRIENDLY</span>
  </div>

  <div class="walkin-bar">
    GOOD MORNING, WALK-INS WELCOME &nbsp;·&nbsp; ウォークイン歓迎 &nbsp;·&nbsp; ترحيب بالزوار بدون حجز
  </div>

  <!-- HERO -->
  <section class="hero-wrap">
    <div class="sunrise-disc"></div>
    <div class="hero-photo-wrap">
      {% if store.has_interior_photos %}
      <img class="hero-slide" src="/assets/{{ store.slug }}/hero-1.jpg" alt="{{ store.name_full_en }} morning burger" />
      <img class="hero-slide" src="/assets/{{ store.slug }}/hero-2.jpg" alt="{{ store.name_full_en }} signature morning menu" />
      {% else %}
      <img class="hero-slide" src="{{ heroFallback }}" alt="{{ store.name_full_en }} — Halal Wagyu Morning Burger" />
      {% endif %}
    </div>
    <div class="hero-overlay"></div>

    <!-- Hero 最上部の店名 -->
    <div class="hero-shopname reveal">
      <p>{{ shopName }}</p>
    </div>

    <div style="position:relative; z-index:1; text-align:center; width:100%; max-width:380px;">
      <p class="label reveal d1" style="margin-bottom:14px;">{{ store.city | upper }}</p>
      <div class="reveal d1" style="margin-bottom:18px;">
        <span class="stamp">Morning &amp; Brunch Only</span>
      </div>
      <h1 class="reveal d2" style="font-family:'Fraunces'; font-size:clamp(2.3rem,9vw,3.6rem); font-weight:600; line-height:1.08; letter-spacing:-.01em; margin-bottom:14px; color:#fbf1de;">
        Good Morning,<br/>
        <em style="color:#f0a631; font-style:italic;">Wagyu.</em>
      </h1>
      <p class="reveal d3" style="font-size:clamp(.85rem,3vw,.95rem); color:rgba(251,241,222,.78); font-weight:400; letter-spacing:.02em; margin-bottom:6px;">
        A fresh-griddled Wagyu burger to start your day right —
      </p>
      <p class="reveal d3" style="font-family:'Fraunces', serif; font-size:clamp(.8rem,2.6vw,.92rem); color:rgba(240,166,49,.92); letter-spacing:.04em; font-style:italic; font-weight:500; margin-bottom:28px;">
        Halal Wagyu Morning Burger &nbsp;·&nbsp; {{ store.hero_place }}
      </p>

      <div class="reveal d4" style="display:flex; flex-direction:column; gap:12px;">
        {% if store.maps_link %}
        <a href="{{ store.maps_link }}" target="_blank" rel="noopener" class="btn-primary" data-ga-event="directions_click" data-ga-location="hero">
          Get Directions
        </a>
        {% endif %}
        {% if store.tablecheck_url %}
        <a href="{{ store.tablecheck_url }}?utm_source=lp&utm_medium=referral" target="_blank" rel="noopener" class="btn-secondary" data-ga-event="reserve_click" data-ga-location="hero">
          Reserve a Table
        </a>
        {% elif store.tel_raw %}
        <a href="tel:{{ store.tel_raw }}" class="btn-primary" data-ga-event="call_click" data-ga-location="hero">
          Call to Reserve · {{ store.tel_display }}
        </a>
        {% else %}
        <p style="font-size:12px; color:rgba(251,241,222,.55); letter-spacing:.04em; padding-top:4px;">Reservation details coming soon</p>
        {% endif %}
      </div>
    </div>
    <div class="scroll-arrow">↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee-wrap">
    <div class="marquee-track">
      <span class="marquee-item">{{ store.name_full_en }}</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Miyazaki Wagyu</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Muslim-Friendly · ムスリムフレンドリー</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Griddled Fresh, Every Morning</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Walk-ins Welcome · ウォークイン歓迎</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">{{ store.name_full_en }}</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Miyazaki Wagyu</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Muslim-Friendly · ムスリムフレンドリー</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Griddled Fresh, Every Morning</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">Walk-ins Welcome · ウォークイン歓迎</span>
      <span class="marquee-dot"></span>
    </div>
  </div>

  <!-- STORY SPLIT -->
  <section style="background:#fbf1de; padding:72px 24px;">
    <div style="max-width:1000px; margin:0 auto;">
      <div class="story-split">
        <div class="story-photo reveal">
          <img src="/assets/Wagyu_Cheese_Burger.jpg" alt="{{ store.name_full_en }} — Wagyu breakfast burger" />
        </div>
        <div class="story-text-wrap reveal d1">
          <p class="label" style="margin-bottom:14px;">OUR MORNING RITUAL</p>
          <h2 style="font-family:'Fraunces'; font-size:clamp(1.7rem,5.5vw,2.4rem); font-weight:600; line-height:1.2; margin-bottom:16px;">
            Same Miyazaki Wagyu.<br/>
            <span class="scribble">A whole new sunrise.
              <svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true">
                <path d="M2,12 C60,4 90,18 150,10 C210,2 250,16 298,8" fill="none" stroke="#f0a631" stroke-width="4" stroke-linecap="round"/>
              </svg>
            </span>
          </h2>
          <p style="font-size:.94rem; line-height:1.9; color:rgba(42,33,24,.7); font-weight:400; margin-bottom:16px;">
            Long before lunch service begins, our griddles are already warm. We take the same 5th-generation Miyazaki Wagyu our steak house is known for, and shape it into a burger built for the first meal of the day — a fresh patty, a soft toasted bun, and a runny egg if you like one.
          </p>
          <p style="font-size:.94rem; line-height:1.9; color:rgba(42,33,24,.7); font-weight:400;">
            Halal-certified from farm to griddle, so every guest — whatever their background — can start the day at the same table.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- BURGER SHOWCASE -->
  <div class="img-frame" style="margin-bottom:0; background:#fbf1de;">
    <div class="img-frame-inner reveal" style="position:relative;">
      <img src="/assets/Wagyu_Big_Cheese_Burger.jpg" alt="{{ store.name_full_en }} signature morning Wagyu burger" style="width:100%; display:block; aspect-ratio:16/9; object-fit:cover; object-position:center 30%;" />
      <div style="position:absolute; left:16px; bottom:16px;">
        <span class="stamp" style="transform:rotate(-3deg);">Today's Signature</span>
      </div>
    </div>
  </div>

  <div class="section-gap"></div>

  <!-- MENU -->
  <section style="background:#fbf1de; padding:72px 24px;">
    <div style="max-width:900px; margin:0 auto;">
      <div style="text-align:center; margin-bottom:40px;">
        <p class="label reveal" style="margin-bottom:12px;">MORNING MENU</p>
        <h2 class="reveal" style="font-family:'Fraunces'; font-size:clamp(1.7rem,6vw,2.4rem); font-weight:600; line-height:1.2;">
          Start Your Day<br/>the Wagyu Way
        </h2>
        <span class="sun-rule reveal"></span>
      </div>

      <div class="menu-grid">
        <div class="menu-card reveal d1">
          <div class="menu-card-img-wrap">
            <div class="menu-card-img-wrap-inner">
              <img class="menu-card-img" src="/assets/Wagyu_Cheese_Burger.jpg" alt="Sunrise Wagyu Cheeseburger" loading="lazy" />
            </div>
          </div>
          <div class="menu-card-body">
            <span class="menu-card-eyebrow">No.1</span>
            <p class="menu-card-name">Sunrise Wagyu Cheeseburger</p>
            <p class="menu-card-desc">Miyazaki Wagyu patty · Melted cheddar · Toasted brioche · A gentle start with a hearty bite.</p>
          </div>
        </div>
        <div class="menu-card reveal d2">
          <div class="menu-card-img-wrap">
            <div class="menu-card-img-wrap-inner">
              <img class="menu-card-img" src="/assets/Wagyu_Big_Cheese_Burger.jpg" alt="Big Morning Wagyu Stack" loading="lazy" />
            </div>
          </div>
          <div class="menu-card-body">
            <span class="menu-card-eyebrow">No.2</span>
            <p class="menu-card-name">Big Morning Wagyu Stack</p>
            <p class="menu-card-desc">Double Miyazaki Wagyu patties · Smoky house sauce · For guests who wake up hungry.</p>
          </div>
        </div>
      </div>
      <p class="reveal" style="text-align:center; font-size:12px; color:rgba(42,33,24,.45); letter-spacing:.04em; margin-top:24px;">Ask our staff about today's seasonal morning specials.</p>
    </div>
  </section>

  <!-- SOURCING STRIP -->
  <div class="img-frame" style="margin-bottom:0; background:#fbf1de;">
    <div class="img-frame-inner reveal">
      <img src="/assets/farm.jpg" alt="宮崎和牛の生産現場 — {{ store.name_full_en }}" style="width:100%; display:block; aspect-ratio:16/9; object-fit:cover; object-position:center center;" />
    </div>
  </div>
  <p class="reveal" style="text-align:center; font-size:11px; color:rgba(42,33,24,.4); letter-spacing:.08em; margin:14px 24px 0;">SAME MIYAZAKI WAGYU · ANY TIME OF DAY</p>

  <div class="section-gap"></div>

  <!-- CUSTOMER PHOTOS -->
  <section style="background:#fbf1de; padding:72px 0;">
    <div style="max-width:360px; margin:0 auto; text-align:center; margin-bottom:32px; padding:0 24px;">
      <p class="label reveal" style="margin-bottom:12px;">OUR GUESTS</p>
      <h2 class="reveal" style="font-family:'Fraunces'; font-size:clamp(1.7rem,6vw,2.4rem); font-weight:600; line-height:1.2;">
        Good Mornings,<br/>Shared Together
      </h2>
      <span class="sun-rule reveal"></span>
    </div>

    <div class="img-frame reveal" style="margin-bottom:0;">
      <div class="img-frame-inner customer-slideshow">
        <img class="customer-slide" src="/assets/family01.jpg" alt="{{ store.name_full_en }} guests" loading="lazy" />
        <img class="customer-slide" src="/assets/family02.jpg" alt="{{ store.name_full_en }} guests" loading="lazy" />
        <img class="customer-slide" src="/assets/family03.jpg" alt="{{ store.name_full_en }} guests" loading="lazy" />
        <img class="customer-slide" src="/assets/family04.jpg" alt="{{ store.name_full_en }} guests" loading="lazy" />
      </div>
      <div class="customer-dots">
        <span class="customer-dot"></span>
        <span class="customer-dot"></span>
        <span class="customer-dot"></span>
        <span class="customer-dot"></span>
      </div>
    </div>
  </section>

  <!-- OFFICIAL NAME -->
  <section style="background:#2a2118; padding:64px 24px; position:relative; overflow:hidden;">
    <div style="position:absolute; top:18px; left:18px; width:28px; height:28px; border-top:1px solid rgba(240,166,49,.45); border-left:1px solid rgba(240,166,49,.45);"></div>
    <div style="position:absolute; top:18px; right:18px; width:28px; height:28px; border-top:1px solid rgba(240,166,49,.45); border-right:1px solid rgba(240,166,49,.45);"></div>
    <div style="position:absolute; bottom:18px; left:18px; width:28px; height:28px; border-bottom:1px solid rgba(240,166,49,.45); border-left:1px solid rgba(240,166,49,.45);"></div>
    <div style="position:absolute; bottom:18px; right:18px; width:28px; height:28px; border-bottom:1px solid rgba(240,166,49,.45); border-right:1px solid rgba(240,166,49,.45);"></div>
    <div style="max-width:820px; margin:0 auto; text-align:center;">
      <p class="label reveal" style="margin-bottom:26px; color:#f0a631;">SHOP NAME</p>
      <p class="reveal d1" style="font-family:'Fraunces', serif; font-size:clamp(1.2rem,4.6vw,1.7rem); font-weight:600; line-height:1.5; color:#fbf1de; letter-spacing:.02em; margin-bottom:22px; overflow-wrap:anywhere;">
        {{ shopName }}
      </p>
      <span class="sun-rule reveal d2" style="margin:0 auto;"></span>
    </div>
  </section>

  <!-- ACCESS + FINAL CTA -->
  <section style="background:#fbf1de; padding:72px 24px; border-top:1px solid rgba(240,166,49,.2);">
    <div style="max-width:900px; margin:0 auto;">
      <div style="text-align:center; margin-bottom:32px;">
        <p class="label reveal" style="margin-bottom:12px;">VISIT US</p>
        <h2 class="reveal" style="font-family:'Fraunces'; font-size:clamp(1.6rem,6vw,2.2rem); font-weight:600; line-height:1.25;">
          We're Waiting<br/>for You in {{ store.city }}
        </h2>
        <span class="sun-rule reveal"></span>
      </div>

      <!-- MAP -->
      {% if store.maps_embed %}
      <div class="reveal" style="margin-bottom:20px;">
        <div class="map-frame">
          <iframe
            src="{{ store.maps_embed }}"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            title="{{ store.name_full_en }} — {{ store.station_en }}"></iframe>
        </div>
        <div class="map-caption">
          <p>{{ store.address_en }}</p>
          {% if store.maps_link %}
          <a href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="directions_click" data-ga-location="map">↗ OPEN IN MAPS</a>
          {% endif %}
        </div>
      </div>
      {% endif %}

      <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:28px;">
        <div class="info-row reveal d1" style="border-color:rgba(240,166,49,.3); background:rgba(240,166,49,.06);">
          <span class="info-icon">☀</span>
          <div>
            <p style="font-size:10px; color:rgba(185,119,42,.9); letter-spacing:.16em; margin-bottom:6px; font-weight:700;">SHOP NAME · 店名</p>
            <p style="font-family:'Fraunces', serif; font-size:14px; font-weight:600; line-height:1.5; color:#2a2118; overflow-wrap:anywhere;">{{ shopName }}</p>
          </div>
        </div>
        {% if store.address_en %}
        <div class="info-row reveal d2">
          <span class="info-icon">—</span>
          <div>
            <p style="font-size:10px; color:rgba(42,33,24,.4); letter-spacing:.1em; margin-bottom:4px; font-weight:700;">ADDRESS</p>
            <p style="font-size:13px; font-weight:400; margin-bottom:3px;">{{ store.address_en }}{% if store.address_postal %} {{ store.address_postal }}{% endif %}, Japan</p>
            <p style="font-size:11px; color:rgba(42,33,24,.5);">Near {{ store.station_en }}</p>
          </div>
        </div>
        {% else %}
        <div class="info-row reveal d2">
          <span class="info-icon">—</span>
          <div>
            <p style="font-size:10px; color:rgba(42,33,24,.4); letter-spacing:.1em; margin-bottom:4px; font-weight:700;">ADDRESS</p>
            <p style="font-size:13px; font-weight:400;">Near {{ store.station_en }} · full address coming soon</p>
          </div>
        </div>
        {% endif %}
        <div class="info-row reveal d3">
          <span class="info-icon">—</span>
          <div>
            <p style="font-size:10px; color:rgba(42,33,24,.4); letter-spacing:.1em; margin-bottom:4px; font-weight:700;">HOURS</p>
            <p style="font-size:13px; font-weight:400; margin-bottom:3px;">{{ store.hours }}</p>
            <p style="font-size:11px; color:rgba(42,33,24,.5);">{{ store.hours_note }}</p>
          </div>
        </div>
        <div class="info-row reveal d4" style="border-color:rgba(110,143,99,.35); background:rgba(110,143,99,.07);">
          <span class="info-icon" style="color:#6e8f63;">✦</span>
          <div>
            <p style="font-size:10px; color:rgba(110,143,99,.9); letter-spacing:.1em; margin-bottom:4px; font-weight:700;">HALAL INFO</p>
            <p style="font-size:13px; font-weight:400; margin-bottom:3px;">Muslim-Friendly · Prayer space available</p>
            <p style="font-size:11px; color:rgba(42,33,24,.5);">No pork · Muslim-friendly</p>
          </div>
        </div>
      </div>

      <div class="reveal" style="display:flex; flex-direction:column; gap:12px;">
        {% if store.maps_link %}
        <a href="{{ store.maps_link }}" target="_blank" rel="noopener" class="btn-primary" data-ga-event="directions_click" data-ga-location="access">
          Get Directions
        </a>
        {% endif %}
        {% if store.tablecheck_url %}
        <a href="{{ store.tablecheck_url }}?utm_source=lp&utm_medium=referral" target="_blank" rel="noopener" class="btn-secondary on-light" data-ga-event="reserve_click" data-ga-location="access">
          Reserve a Table
        </a>
        {% elif store.tel_raw %}
        <a href="tel:{{ store.tel_raw }}" class="btn-primary" data-ga-event="call_click" data-ga-location="access">
          Call to Reserve · {{ store.tel_display }}
        </a>
        {% else %}
        <p style="text-align:center; font-size:12px; color:rgba(42,33,24,.45); letter-spacing:.04em;">Reservation details coming soon</p>
        {% endif %}
      </div>
    </div>
  </section>

  <footer style="background:#2a2118; padding:44px 24px 32px; text-align:center; border-top:1px solid rgba(240,166,49,.12);">
    <p style="font-family:'Fraunces', serif; font-size:clamp(.95rem,3.2vw,1.15rem); font-weight:600; color:#fbf1de; letter-spacing:.02em; line-height:1.55; max-width:560px; margin:0 auto 18px; overflow-wrap:anywhere;">
      {{ shopName }}
    </p>
    <p style="font-size:10px; color:rgba(251,241,222,.35); letter-spacing:.24em; margin-bottom:22px;">MIYAZAKI WAGYU &nbsp;·&nbsp; MORNING &amp; BRUNCH</p>
    <div style="display:flex; justify-content:center; gap:28px;">
      {% if store.tablecheck_url %}
      <a href="{{ store.tablecheck_url }}?utm_source=lp&utm_medium=referral" target="_blank" rel="noopener" style="font-size:10px; color:rgba(251,241,222,.35); text-decoration:none; letter-spacing:.14em;" data-ga-event="reserve_click" data-ga-location="footer">RESERVATION</a>
      {% elif store.tel_raw %}
      <a href="tel:{{ store.tel_raw }}" style="font-size:10px; color:rgba(251,241,222,.35); text-decoration:none; letter-spacing:.14em;" data-ga-event="call_click" data-ga-location="footer">CALL {{ store.tel_display }}</a>
      {% endif %}
      {% if store.maps_link %}
      <a href="{{ store.maps_link }}" target="_blank" rel="noopener" style="font-size:10px; color:rgba(251,241,222,.35); text-decoration:none; letter-spacing:.14em;" data-ga-event="directions_click" data-ga-location="footer">MAPS</a>
      {% endif %}
    </div>
  </footer>

  <script>
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.07, rootMargin: '0px 0px -28px 0px' });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    window.addEventListener('load', () => {
      document.querySelectorAll('.hero-wrap .reveal').forEach(el => el.classList.add('visible'));
    });

    /* === GA4 custom event tracking === */
    (function(){
      if (typeof gtag !== 'function') return;
      document.addEventListener('click', function(e){
        var el = e.target.closest('[data-ga-event]');
        if (!el) return;
        var evtName = el.getAttribute('data-ga-event');
        var location = el.getAttribute('data-ga-location') || '';
        gtag('event', evtName, {
          'event_category': 'engagement',
          'event_label': location,
          'store_name': '{{ store.slug }}',
          'store_area': '{{ store.region }}',
          'brand': '{{ stores.brand.brand_slug }}'
        });
      }, true);
    })();
  </script>
</body>
</html>
