  <!-- TODO: 上のGTM-XXXXXXXを本番のGTMコンテナIDに差し替えてください -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ store.name_full_en }} — Halal Wagyu Morning Burger. Muslim-Friendly breakfast &amp; brunch, made with Miyazaki Wagyu." />
  <title>{{ store.name_full_en }}</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600;9..144,700&family=DM+Sans:wght@300;400;500;700&family=Caveat:wght@500;700&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: #fbf1de;
      color: #2a2118;
      font-family: 'DM Sans', sans-serif;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* ── Reveal on scroll ── */
    .reveal { opacity: 0; transform: translateY(26px); transition: opacity .9s cubic-bezier(.22,1,.36,1), transform .9s cubic-bezier(.22,1,.36,1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .d1 { transition-delay: .08s; } .d2 { transition-delay: .18s; } .d3 { transition-delay: .30s; } .d4 { transition-delay: .44s; }

    .sun-rule { display: block; width: 40px; height: 3px; border-radius: 3px; background: linear-gradient(90deg, #f0a631, #e56b4f); margin: 14px auto 0; }
    .label { font-size: 10px; letter-spacing: .42em; color: #b9772a; font-family: 'DM Sans', sans-serif; font-weight: 700; text-transform: uppercase; }

    /* Hand-written "stamp" badge — signature element */
    .stamp {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: 'Caveat', cursive; font-weight: 700; font-size: 22px;
      color: #fbf1de; background: #e56b4f;
      padding: 8px 20px 10px; border-radius: 100px;
      transform: rotate(-4deg);
      box-shadow: 0 6px 16px rgba(229,107,79,.35);
      border: 2px dashed rgba(251,241,222,.7);
    }

    .halal-sticky { position: fixed; top: 14px; right: 14px; z-index: 200; display: flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: 100px; border: 1px solid rgba(240,166,49,.6); background: rgba(42,33,24,.78); backdrop-filter: blur(12px); }
    .halal-dot { width: 7px; height: 7px; border-radius: 50%; background: #f0a631; }
    .halal-sticky span { font-size: 10px; letter-spacing: .14em; color: #fbf1de; font-weight: 500; }

    .walkin-bar { background: #6e8f63; font-size: 11px; letter-spacing: .18em; font-weight: 700; text-align: center; padding: 9px 16px; color: #fbf1de; }

    .img-frame { padding: 0 20px; margin-bottom: 20px; }
    .img-frame-inner { border-radius: 16px; overflow: hidden; position: relative; }
    .section-gap { height: 10px; background: #fbf1de; }

    /* ── Google Map embed ── */
    .map-frame { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; border: 1px solid rgba(240,166,49,.3); background: #f2e6c9; }
    .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
    .map-caption { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 10px; padding: 0 2px; }
    .map-caption p { font-size: 11px; color: rgba(42,33,24,.55); letter-spacing: .04em; }
    .map-caption a { font-size: 11px; letter-spacing: .1em; color: #b9772a; text-decoration: none; white-space: nowrap; font-weight: 700; }
    .map-caption a:hover { text-decoration: underline; }
    @media (max-width: 640px) { .map-frame { aspect-ratio: 4 / 3; } }

    /* ── HERO ── */
    .hero-wrap { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; padding: 0 20px 52px; overflow: hidden; background: #2a2118; }
    .hero-photo-wrap { position: absolute; inset: 0; overflow: hidden; }
    .hero-slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: hero-slide-fade 12s infinite; }
    @keyframes hero-slide-fade { 0% { opacity: 0; transform: scale(1.04); } 8% { opacity: 1; } 50% { opacity: 1; transform: scale(1.12); } 58% { opacity: 0; transform: scale(1.12); } 100% { opacity: 0; transform: scale(1.04); } }
    .hero-slide:nth-child(1) { animation-delay: 0s; }
    .hero-slide:nth-child(2) { animation-delay: 6s; }
    .hero-photo-wrap .hero-slide:only-child { animation: none; opacity: 1; transform: scale(1.04); }

    /* signature: rising sun disc behind the hero photo */
    .sunrise-disc {
      position: absolute; left: 50%; bottom: -28%; width: 560px; height: 560px;
      transform: translateX(-50%);
      border-radius: 50%;
      background: radial-gradient(circle at 50% 40%, #ffe1a0 0%, #f0a631 42%, #e56b4f 72%, rgba(229,107,79,0) 78%);
      opacity: .55; filter: blur(2px);
      animation: sunrise-rise 1.8s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes sunrise-rise { from { transform: translateX(-50%) translateY(60px); opacity: 0; } to { transform: translateX(-50%) translateY(0); opacity: .55; } }

    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(42,33,24,.15) 0%, rgba(42,33,24,.2) 40%, rgba(42,33,24,.82) 74%, rgba(42,33,24,.97) 100%); pointer-events: none; }

    .hero-shopname {
      position: absolute; top: 42px; left: 0; right: 0; margin: 0 auto;
      text-align: center; z-index: 2; width: 92%; max-width: 620px;
      padding: 0 8px;
    }
    .hero-shopname p {
      font-family: 'Fraunces', serif;
      font-size: clamp(1.0rem, 3.6vw, 1.3rem);
      font-weight: 600;
      letter-spacing: .02em;
      line-height: 1.4;
      color: #fbf1de;
      text-shadow: 0 2px 4px rgba(0,0,0,.9), 0 4px 18px rgba(0,0,0,.8);
      overflow-wrap: anywhere;
    }

    @keyframes pulse-ring { 0% { box-shadow: 0 0 0 0 rgba(240,166,49,.55); } 70% { box-shadow: 0 0 0 16px rgba(240,166,49,0); } 100% { box-shadow: 0 0 0 0 rgba(240,166,49,0); } }
    .btn-primary { display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 100px; background: #f0a631; color: #2a2118; padding: 16px 28px; font-size: 15px; letter-spacing: .03em; text-decoration: none; font-weight: 700; animation: pulse-ring 2.4s infinite; transition: background .2s, transform .2s; }
    .btn-primary:hover { background: #dd961f; transform: translateY(-2px); }
    .btn-secondary { display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 100px; background: transparent; color: #fbf1de; padding: 15px 28px; font-size: 14px; letter-spacing: .03em; text-decoration: none; border: 1px solid rgba(251,241,222,.4); transition: background .2s; font-weight: 500; }
    .btn-secondary:hover { background: rgba(251,241,222,.1); }
    .btn-secondary.on-light { color: #2a2118; border-color: rgba(42,33,24,.3); }
    .btn-secondary.on-light:hover { background: rgba(42,33,24,.06); }

    @keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(8px)} }
    .scroll-arrow { position: absolute; bottom: 20px; left: 50%; color: rgba(251,241,222,.4); font-size: 18px; animation: bounce 1.9s ease-in-out infinite; }

    /* ── Marquee ticker ── */
    .marquee-wrap { background: #fbf1de; overflow: hidden; border-top: 2px dashed rgba(110,143,99,.4); border-bottom: 2px dashed rgba(110,143,99,.4); padding: 13px 0; }
    @keyframes marquee-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .marquee-track { display: flex; white-space: nowrap; animation: marquee-scroll 24s linear infinite; will-change: transform; }
    .marquee-track:hover { animation-play-state: paused; }
    .marquee-item { display: inline-flex; align-items: center; gap: 10px; padding: 0 36px; font-family: 'Fraunces', serif; font-style: italic; font-size: clamp(.85rem, 3vw, 1rem); font-weight: 500; letter-spacing: .02em; color: #6e8f63; }
    .marquee-dot { width: 5px; height: 5px; border-radius: 50%; background: rgba(240,166,49,.6); flex-shrink: 0; }

    /* ── Story split ── */
    .story-split { display: grid; grid-template-columns: 1fr; gap: 28px; align-items: center; }
    @media (min-width: 860px) { .story-split { grid-template-columns: 1fr 1fr; gap: 56px; } }
    .story-photo { border-radius: 20px; overflow: hidden; aspect-ratio: 4/5; }
    .story-photo img { width: 100%; height: 100%; object-fit: cover; }

    /* ── Menu ── */
    .menu-grid { display: flex; flex-direction: column; gap: 22px; }
    @media (min-width: 700px) { .menu-grid { flex-direction: row; } }
    .menu-card { background: #fffdf6; border: 1px solid rgba(240,166,49,.22); border-radius: 20px; overflow: hidden; flex: 1; box-shadow: 0 10px 28px rgba(42,33,24,.06); }
    .menu-card-img-wrap { padding: 14px 14px 0; }
    .menu-card-img-wrap-inner { border-radius: 14px; overflow: hidden; aspect-ratio: 1/1; }
    .menu-card-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
    .menu-card:hover .menu-card-img { transform: scale(1.05); }
    .menu-card-body { padding: 18px 20px 22px; }
    .menu-card-eyebrow { font-family: 'Caveat', cursive; font-size: 20px; font-weight: 700; color: #e56b4f; margin-bottom: 2px; display: block; }
    .menu-card-name { font-family: 'Fraunces', serif; font-size: 1.3rem; font-weight: 600; margin-bottom: 8px; color: #2a2118; line-height: 1.25; }
    .menu-card-desc { font-size: 12.5px; color: rgba(42,33,24,.6); line-height: 1.75; font-weight: 400; }

    .info-row { display: flex; gap: 14px; align-items: flex-start; background: #fffdf6; padding: 16px; border-radius: 14px; border: 1px solid rgba(240,166,49,.16); }
    .info-icon { color: #e56b4f; font-size: 16px; flex-shrink: 0; margin-top: 1px; }

    .story-text-wrap { max-width: 480px; }

    /* ── Customer photo slideshow ── */
    .customer-slideshow { position: relative; aspect-ratio: 16/9; overflow: hidden; }
    .customer-slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: customer-fade 24s infinite; will-change: opacity, transform; }
    @keyframes customer-fade { 0% { opacity: 0; transform: scale(1.0); } 4% { opacity: 1; } 25% { opacity: 1; transform: scale(1.06); } 29% { opacity: 0; transform: scale(1.06); } 100% { opacity: 0; transform: scale(1.0); } }
    .customer-slide:nth-child(1) { animation-delay: 0s; }
    .customer-slide:nth-child(2) { animation-delay: 6s; }
    .customer-slide:nth-child(3) { animation-delay: 12s; }
    .customer-slide:nth-child(4) { animation-delay: 18s; }
    .customer-dots { display: flex; justify-content: center; gap: 7px; margin-top: 14px; }
    .customer-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(240,166,49,.3); animation: customer-dot-pulse 24s infinite; }
    @keyframes customer-dot-pulse { 0%,25% { background: #f0a631; } 29%,100% { background: rgba(240,166,49,.3); } }
    .customer-dot:nth-child(1) { animation-delay: 0s; }
    .customer-dot:nth-child(2) { animation-delay: 6s; }
    .customer-dot:nth-child(3) { animation-delay: 12s; }
    .customer-dot:nth-child(4) { animation-delay: 18s; }

    /* underline scribble for emphasis words */
    .scribble { position: relative; white-space: nowrap; }
    .scribble svg { position: absolute; left: -2%; bottom: -6px; width: 104%; height: 10px; }
  </style>
</head>
<body>
